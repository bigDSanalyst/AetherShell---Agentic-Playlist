# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Provenance signing -------------------------------------------------------
# Ed25519 private key (PKCS#8 PEM, or base64 of the PEM). Without it the server
# generates a random key at startup and signatures stop verifying after restart.
# Generate: node -e "const c=require('crypto');console.log(Buffer.from(c.generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'})).toString('base64'))"
AETHERSHELL_SIGNING_KEY=""

# --- Access control -----------------------------------------------------------
# If set, every /api request must send it in the x-aethershell-token header
# (the UI asks for it once and keeps it in localStorage). Set this whenever the
# server is reachable by anyone but you.
AETHERSHELL_ACCESS_TOKEN=""
# Interface to bind. Defaults to 127.0.0.1, or 0.0.0.0 on Cloud Run (K_SERVICE).
HOST=""
# Per-IP limit on /api requests (default 60 per 5 minutes).
RATE_LIMIT_MAX="60"
RATE_LIMIT_WINDOW_MS="300000"
# Set to "true" behind one trusted reverse proxy so per-IP limits see the client IP.
TRUST_PROXY=""

# --- YouTube ------------------------------------------------------------------
# YouTube Data API v3 key; needed only for playlist URLs (single videos work without it).
YOUTUBE_API_KEY=""
YOUTUBE_MAX_PLAYLIST_VIDEOS="25"
# Preferred caption language (BCP 47), e.g. "en". Empty = the video's default track.
YOUTUBE_TRANSCRIPT_LANG=""

# --- Models and guard thresholds ---------------------------------------------
# Comma-separated Gemini models tried in order.
GEMINI_MODELS="gemini-flash-latest,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.1-pro-preview"
GEMINI_TRANSCRIBE_MODEL=""
# Minimum share of the logic's content words (Alpha) / word pairs (Beta) that
# must appear in the transcript for the grounding check to pass.
GUARD_MIN_WORD_OVERLAP="0.5"
GUARD_MIN_BIGRAM_OVERLAP="0.2"

# --- Run ledger and drift -----------------------------------------------------
# Append-only, hash-chained record of signings and guard verdicts.
# Default: data/ledger.jsonl. Set to "" to keep it in memory only.
# On Cloud Run the local disk is ephemeral; point this at a mounted volume.
AETHERSHELL_LEDGER_PATH="data/ledger.jsonl"
# Drift monitor: flag a guard failure rate credibly above DRIFT_P0 at level DRIFT_ALPHA.
DRIFT_P0="0.15"
DRIFT_ALPHA="0.01"
