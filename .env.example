# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Provenance signing -------------------------------------------------------
# Ed25519 private key (PKCS#8 PEM, or base64 of the PEM). Without it the server
# generates a random key at startup and signatures stop verifying after restart.
# Generate: node -e "const c=require('crypto');console.log(Buffer.from(c.generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'})).toString('base64'))"
AETHERSHELL_SIGNING_KEY=""

# --- Access control -----------------------------------------------------------
# If set, visitors without it can browse and make DEMO_LIMIT_PER_IP AI calls;
# signing, imports, settings, the archive export and the doctor report need it
# (sent in the x-aethershell-token header; the app asks for it once and keeps it
# in localStorage). Set this whenever the server is reachable by anyone but you.
AETHERSHELL_ACCESS_TOKEN=""
# Only when AETHERSHELL_ACCESS_TOKEN is set: how many AI calls (chat, synthesis,
# innershell, guards, transcription, playlist ingest) a visitor without the token
# may make per IP before being asked to deploy their own copy or enter the token.
# Visitors can always browse; signing, imports and settings always need the token.
# Default 3; 0 turns visitor AI calls off. Counts are kept in data/demo-usage.json.
# Behind a proxy (Cloud Run, AI Studio) also set TRUST_PROXY=true, or every
# visitor shares the proxy's address and one allowance.
DEMO_LIMIT_PER_IP="3"
# Interface to bind. Defaults to 127.0.0.1, or 0.0.0.0 on Cloud Run (K_SERVICE).
HOST=""
# Per-IP limit on /api requests (default 60 per 5 minutes).
RATE_LIMIT_MAX="60"
RATE_LIMIT_WINDOW_MS="300000"
# Set to "true" behind one trusted reverse proxy so per-IP limits see the client IP.
TRUST_PROXY=""

# --- YouTube ------------------------------------------------------------------
# YouTube Data API v3 key; needed only for playlist URLs (single videos work without it).
YOUTUBE_API_KEY=""
# Optional: "Sign in with Google to pick your playlists". The OAuth *client ID*
# (Web application; add the app's address under Authorized JavaScript origins).
# Public by design; the client secret is not used. See the README.
GOOGLE_OAUTH_CLIENT_ID=""
YOUTUBE_MAX_PLAYLIST_VIDEOS="25"
# Preferred caption language (BCP 47), e.g. "en". Empty = the video's default track.
YOUTUBE_TRANSCRIPT_LANG=""

# --- Models and guard thresholds ---------------------------------------------
# Models tried in order, as provider:model (server/models.ts). A name with no
# provider prefix is a Gemini model. Examples:
#   gemini:gemini-flash-latest   local:qwen3:8b   openrouter:qwen/qwen3-8b:free   openai:gpt-4.1-mini
# Which models REVIEW guard verdicts is not set here: it is the owner-signed
# charter's reviewModels.
AETHERSHELL_MODELS=""
# Older name for the same list (used when AETHERSHELL_MODELS is empty).
GEMINI_MODELS="gemini-flash-latest,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.1-pro-preview"

# --- Other model providers (each optional) -------------------------------------
# Any OpenAI-compatible server you run: Ollama (http://127.0.0.1:11434/v1),
# llama.cpp server, vLLM, LM Studio. Free and private; models named local:<name>.
LOCAL_LLM_BASE_URL=""
LOCAL_LLM_API_KEY=""
# OpenRouter: many hosted open models under one key; models named openrouter:<name>.
OPENROUTER_API_KEY=""
# OpenAI, or another compatible endpoint via OPENAI_BASE_URL; models named openai:<name>.
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
# Your requests-per-day limit per model, read off AI Studio -> Rate Limit (free
# tier: e.g. 20). Google does not report remaining quota to apps; without this
# the usage panel shows counts but no bar. Not a guard setting.
GEMINI_DAILY_REQUEST_LIMIT=""
# Where today's Gemini usage counts are kept (default: next to the ledger).
AETHERSHELL_USAGE_PATH=""
GEMINI_TRANSCRIBE_MODEL=""

# --- Run ledger and drift -----------------------------------------------------
# Append-only, hash-chained record of signings and guard verdicts.
# Default: data/ledger.jsonl. Set to "" to keep it in memory only.
# On Cloud Run the local disk is ephemeral; point this at a mounted volume.
AETHERSHELL_LEDGER_PATH="data/ledger.jsonl"
# Drift monitor: flag a guard failure rate credibly above DRIFT_P0 at level DRIFT_ALPHA.
DRIFT_P0="0.15"
DRIFT_ALPHA="0.01"

# --- Owner authority over the guards ------------------------------------------
# Every guard setting lives in a charter signed by the OWNER's key. The server
# holds only the public half, so it can check the owner's signature but never
# make one. Without a valid charter the guards do not run. Guard thresholds are
# NOT read from the environment.
#   npm run owner -- keygen          (on your own machine; prints the line below)
#   npm run owner -- init --key ~/.aethershell/owner-key.pem --reason "..."
AETHERSHELL_OWNER_PUBLIC_KEY=""
# Where the signed charter is read from (default data/charter.json).
AETHERSHELL_CHARTER_PATH=""

# --- Learning (AetherTwin) ----------------------------------------------------
# Lessons from rejected syntheses and examples from passed ones. A cache checked
# against the ledger on every use. Default data/learning.jsonl; "" = memory only.
AETHERSHELL_LEARNING_PATH=""
